# ==========================================
# Med Bazar — Production & Development Configuration
# ==========================================

# Node & Server
NODE_ENV=production
PORT=5000

# PostgreSQL Database (Prisma connection string)
DATABASE_URL="postgresql://medbazar_admin:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/medbazar_prod?schema=public&sslmode=prefer"

# JWT Authentication
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# CORS Configuration (comma-separated origins allowed in production)
CORS_ORIGIN="https://app.medbazar.in,https://admin.medbazar.in,http://localhost:5173"

# Private File Storage (Prescriptions are stored privately, never in public web roots)
STORAGE_DRIVER="local" # "local" or "s3"
SECURE_STORAGE_PATH="./storage/secure_prescriptions"
# S3_BUCKET_NAME="medbazar-private-documents"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="ap-south-1"

# Payment Gateways (Leave empty if unconfigured; APIs will truthfully report PENDING)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# External Communication Channels (Disabled by default until credentials configured)
ENABLE_SMS_NOTIFICATIONS=false
SMS_PROVIDER_API_KEY=""
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Frontend (Vite)
VITE_API_URL="http://localhost:5000/api/v1"
VITE_USE_MOCK=false
VITE_APP_ENV="production"
